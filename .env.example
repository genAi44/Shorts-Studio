# انسخ هذا الملف باسم .env وضع مفاتيحك (لا تشاركها مع أحد)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SERPER_API_KEY=        # optional — https://serper.dev (2500 free/month)

# --- FreeLLMAPI (Unified Local/Remote LLM Router) ---
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=

# --- تخصيص المزودات لكل دور (Roles: script | director | style | factcheck | chat_edit) ---
# المزوّدات المتاحة: freellmapi | deepseek | gemini | openai
SCRIPT_PROVIDER=freellmapi
DIRECTOR_PROVIDER=freellmapi
STYLE_PROVIDER=freellmapi
FACTCHECK_PROVIDER=gemini
CHAT_EDIT_PROVIDER=freellmapi

# أسماء النماذج (غيّرها إن تغيّرت لدى المزوّد)
# نموذج كتابة السكربت: gemini أو deepseek (الافتراضي gemini مع بحث جوجل، ويتراجع تلقائياً إلى deepseek عند الفشل)
SCRIPT_MODEL=gemini
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_MODEL=eleven_multilingual_v2
# 1 = بحث جوجل المرتبط في كتابة السكربت وفحص الحقائق (يتراجع تلقائياً إن لم يُدعم)
GEMINI_GROUNDING=1
# سرعة النطق 0.7 إلى 1.2 (اختياري)
# ELEVENLABS_SPEED=1.05

PORT=8742

# محرّك الرسم: remotion (الافتراضي إن ثُبّت) أو pil (احتياطي أبسط)
# ENGINE=remotion
# مسار متصفح Chromium لـ Remotion (اختياري؛ وإلا ينزّله Remotion تلقائياً)
# REMOTION_BROWSER=
# عدد العمليات المتوازية للرندر، ودقة المعاينة السريعة (0.5 = نصف الدقة)
# REMOTION_CONCURRENCY=2
# REMOTION_SCALE=1

# --- الصور الحقيقية (اختياري) ---
# Wikimedia Commons لا يحتاج مفتاحاً. Pexels مفتاح مجاني من pexels.com/api
PHOTOS=1
# التحقق من الصور بالرؤية: auto (Gemini ثم FreeLLMAPI المجاني عند 429) | gemini | freellmapi | off (تعطيل بوابة التحقق: تُقبل أفضل صورة بالتطابق)
PHOTO_VERIFY=auto
PEXELS_API_KEY=
# قص الخلفية: pip install rembg onnxruntime (ينزّل نموذجاً ~170MB أول مرة)
REMBG_MODEL=u2net

# Phase 0 critic: grade every finished video (outputs/<job>/critic/report.html). Vision: Gemini, then FreeLLMAPI.
CRITIC=0
# Gemini model the critic uses (empty = GEMINI_MODEL). Calibrated results: docs/CRITIC.md
CRITIC_GEMINI_MODEL=
